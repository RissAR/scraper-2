# Токен Telegram бота
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID чату або каналу для відправки повідомлень (можна декілька через кому)
TELEGRAM_CHAT_ID=

# Інтервал опитування в секундах (2-4 хв = 120-240 с)
POLL_INTERVAL_SECONDS=180

# Параметри пошуку
CITY_NAME=Дніпро
CITY_ID=121
CATEGORY_ID=1760

# Діапазон цін у грн
MIN_PRICE=3000
MAX_PRICE=25000

# Райони для виключення (через кому)
EXCLUDED_DISTRICTS=

# Підтримка проксі (необов'язково)
PROXY_URL=

# База даних SQLite
DB_PATH=data/rieltor_bot.db

# Захист від старих оголошень, піднятих у ТОП
MAX_AD_AGE_HOURS=48
INIT_MARK_AS_SEEN=true

# Фільтрація виключно від власників (жорстке відсіювання ріелторів)
ONLY_OWNERS=true
MAX_OWNER_ACTIVE_ADS=2

# Опціональний Bearer-токен OLX
OLX_BEARER_TOKEN=
